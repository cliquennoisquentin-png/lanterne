# Lanterne — modèle de configuration
#
# En local : copiez ce fichier sous le nom « .env » (il n'est jamais envoyé sur GitHub) et remplissez
# ce dont vous avez besoin. « npm run dev » le lit tout seul.
# Sur Railway : pas de fichier .env, ces mêmes noms se saisissent dans l'onglet « Variables » du service.
# Ne mettez jamais de vraie clé dans ce fichier-ci.

# --- Indispensable -------------------------------------------------------------------------------

# Adresse(s) mail du ou des administrateurs fondateurs, séparées par des virgules.
ADMIN_EMAILS=vous@exemple.fr

# --- Base de données -----------------------------------------------------------------------------

# Base PostgreSQL. Sur Railway, elle est fournie par le service Postgres.
# Laissée vide en local : une base de test est créée toute seule dans le dossier .data/
# (La commande « npm run restore » ne lit pas ce fichier : on lui donne DATABASE_URL à la main, exprès.)
DATABASE_URL=
# À passer à « true » seulement si la base exige une connexion chiffrée sans certificat vérifié.
DATABASE_SSL=
# Dossier de la base de test locale (facultatif, .data/ par défaut).
PGLITE_DIR=

# --- Envoi des mails (liens de connexion, invitations, sauvegardes) ------------------------------
# Sans aucune clé, les mails ne partent pas : ils s'affichent dans le terminal. Pratique en local.

# Brevo : une clé API qui commence par « xkeysib- ». Une adresse d'expéditeur vérifiée suffit.
BREVO_API_KEY=
# Ou Resend (demande un nom de domaine vérifié).
RESEND_API_KEY=
# Expéditeur des mails. Il doit être vérifié chez le service d'envoi.
MAIL_FROM="Lanterne <adresse@exemple.fr>"
# Nombre maximal de mails par jour (280 par défaut, sous le quota gratuit de Brevo).
MAIL_DAILY_LIMIT=

# --- Sauvegardes ---------------------------------------------------------------------------------

# Qui reçoit la sauvegarde de chaque nuit (par défaut : ADMIN_EMAILS).
BACKUP_EMAILS=

# --- Divers --------------------------------------------------------------------------------------

# « production » sur Railway (cookies sécurisés, HTTPS obligatoire). Rien en local.
NODE_ENV=
# Port du serveur en local (3000 par défaut). Railway le fixe lui-même.
PORT=
# Adresse publique du site, si elle diffère de celle donnée par Railway. Sert aux liens dans les mails.
PUBLIC_URL=
# Adresse affichée dans les mentions légales.
CONTACT_EMAIL=
# Plafond d'appels par minute et par adresse (600 par défaut). Protège la base des robots.
API_RATE_LIMIT=
